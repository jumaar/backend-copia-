generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ROLES {
  id_rol            Int              @id @default(autoincrement())
  nombre_rol        String?
  permisos_creables PERMISOS_ROLES[] @relation("creatable")
  permisos_creador  PERMISOS_ROLES[] @relation("creator")
  tokens_roles      TOKEN_REGISTRO[]
  usuarios          USUARIOS[]
}

model PERMISOS_ROLES {
  id_rol_creador Int
  id_rol_creable Int
  rol_creable    ROLES @relation("creatable", fields: [id_rol_creable], references: [id_rol])
  rol_creador    ROLES @relation("creator", fields: [id_rol_creador], references: [id_rol])

  @@id([id_rol_creador, id_rol_creable])
}

model TOKEN_REGISTRO {
  id                   Int       @id @default(autoincrement())
  token                String    @unique
  creado_en            DateTime  @default(now())
  expira_en            DateTime
  es_usado             Boolean   @default(false)
  id_usuario_creador   Int
  id_rol_nuevo_usuario Int
  id_usuario_nuevo     Int?      @unique
  rol_nuevo_usuario    ROLES     @relation(fields: [id_rol_nuevo_usuario], references: [id_rol])
  creador              USUARIOS  @relation("creador", fields: [id_usuario_creador], references: [id_usuario])
  nuevo_usuario        USUARIOS? @relation("nuevo_usuario", fields: [id_usuario_nuevo], references: [id_usuario])
}

model USUARIOS {
  id_usuario             Int                        @id @default(autoincrement())
  nombre_usuario         String?
  apellido_usuario       String?
  identificacion_usuario String?                    @unique
  celular                Decimal?                   @unique
  email                  String                     @unique
  contraseña            String
  activo                 Boolean
  fecha_creacion         DateTime                   @default(now())
  fecha_ultima_modifi    DateTime                   @updatedAt
  id_rol                 Int
  id_admin             Int
  frigorificos           FRIGORIFICO[]              @relation("UsuarioFrigorifico")
  logisticas             LOGISTICA[]                 @relation("UsuarioLogistica")
  refresh_tokens         REFRESH_TOKENS[]            @relation("UsuarioRefreshToken")
  tiendas                TIENDAS[]                   @relation("UsuarioTienda")
  tokens_creados         TOKEN_REGISTRO[]            @relation("creador")
  tokens_usados          TOKEN_REGISTRO?             @relation("nuevo_usuario")
  transacciones          TRANSACCIONES[]             @relation("UsuarioTransaccion")
  rol                    ROLES                      @relation(fields: [id_rol], references: [id_rol])
  admin_transacciones    TRANSACCIONES[]             @relation("AdminTransaccion")
  admin_tiendas          TIENDAS[]                   @relation("AdminTienda")
  admin_frigorificos     FRIGORIFICO[]               @relation("AdminFrigorifico")
  admin_logisticas       LOGISTICA[]                 @relation("AdminLogistica")
  admin_neveras          NEVERAS[]                   @relation("AdminNevera")
  admin_empaques         EMPAQUES[]                  @relation("AdminEmpaque")
  admin_estaciones       ESTACIONES[]                @relation("AdminEstacion")
  admin_productos        PRODUCTOS[]                 @relation("AdminProducto")
  admin_promociones      PROMOCIONES[]               @relation("AdminPromocion")
  admin_departamentos    DEPARTAMENTO[]              @relation("AdminDepartamento")
  admin_ciudades         CIUDAD[]                    @relation("AdminCiudad")
  admin_reportes         REPORTE_ESTADO_NEVERAS[]    @relation("AdminReporteEstado")
  admin_stocks           STOCK_NEVERA[]              @relation("AdminStockNevera")
  admin_bibliotecas      BIBLIOTECA[]                @relation("AdminBiblioteca")
  admin_listas           LISTA_DE_REPRODUCCION[]     @relation("AdminListaReproduccion")
  admin_items            ITEMS_DE_REPRODUCCION[]     @relation("AdminItemsReproduccion")
}

model DEPARTAMENTO {
  id__departamento    Int      @id @default(autoincrement())
  nombre_departamento String?
  id_admin            Int
  ciudades            CIUDAD[]
  admin               USUARIOS @relation("AdminDepartamento", fields: [id_admin], references: [id_usuario])
}

model CIUDAD {
  id_ciudad        Int           @id @default(autoincrement())
  nombre_ciudad    String?
  id__departamento Int
  id_admin               Int
  departamento     DEPARTAMENTO  @relation(fields: [id__departamento], references: [id__departamento])
  frigorificos     FRIGORIFICO[]
  tiendas          TIENDAS[]
  admin            USUARIOS      @relation("AdminCiudad", fields: [id_admin], references: [id_usuario])
}

model TIENDAS {
  id_tienda      Int       @id @default(autoincrement())
  id_usuario     Int
  id_admin       Int
  nombre_tienda  String
  direccion      String    @unique
  id_ciudad      Int
  fecha_creacion DateTime  @default(now())
  neveras        NEVERAS[]
  ciudad         CIUDAD    @relation(fields: [id_ciudad], references: [id_ciudad])
  usuario        USUARIOS  @relation("UsuarioTienda", fields: [id_usuario], references: [id_usuario])
  admin          USUARIOS @relation("AdminTienda", fields: [id_admin], references: [id_usuario])
}

model FRIGORIFICO {
  id_frigorifico     Int          @id @default(autoincrement())
  id_usuario         Int
  id_admin           Int
  nombre_frigorifico String
  direccion          String       @unique
  id_ciudad          Int
  fecha_creacion     DateTime     @default(now())
  estaciones         ESTACIONES[]
  ciudad             CIUDAD       @relation(fields: [id_ciudad], references: [id_ciudad])
  usuario            USUARIOS     @relation("UsuarioFrigorifico", fields: [id_usuario], references: [id_usuario])
  admin              USUARIOS     @relation("AdminFrigorifico", fields: [id_admin], references: [id_usuario])
}

model LOGISTICA {
  id_logistica   Int        @id @default(autoincrement())
  id_usuario     Int
  id_admin       Int
  nombre_empresa String
  placa_vehiculo String
  empaques       EMPAQUES[]
  usuario        USUARIOS   @relation("UsuarioLogistica", fields: [id_usuario], references: [id_usuario])
  admin          USUARIOS   @relation("AdminLogistica", fields: [id_admin], references: [id_usuario])
}

model ESTADO_NEVERA {
  id_estado_nevera Int       @id @default(autoincrement())
  estado_nevera    String
  neveras          NEVERAS[]
}

model NEVERAS {
  id_nevera             Int                      @id @default(autoincrement())
  contraseña           String                   @unique
  id_estado_nevera      Int
  id_tienda             Int
  version_software      Decimal
  ultima_conexion       DateTime?
  id_lista_reproduccion Int?
  fecha_activacion      DateTime?
  fecha_creacion        DateTime                 @default(now())
  hora_ultimo_surtido   DateTime?
  id_admin              Int
  empaques              EMPAQUES[]
  estadoNevera          ESTADO_NEVERA            @relation(fields: [id_estado_nevera], references: [id_estado_nevera])
  lista_reproduccion    LISTA_DE_REPRODUCCION?   @relation(fields: [id_lista_reproduccion], references: [id_lista_reproduccion])
  tienda                TIENDAS                  @relation(fields: [id_tienda], references: [id_tienda])
  reportes_estado       REPORTE_ESTADO_NEVERAS[]
  transacciones        TRANSACCIONES[]
  stockProductos        STOCK_NEVERA[]
  admin                 USUARIOS                @relation("AdminNevera", fields: [id_admin], references: [id_usuario])
}

model PRODUCTOS {
  id_producto          Int            @id @default(autoincrement())
  nombre_producto      String
  descripcion_producto String?
  peso_nominal_g       Int
  precio_venta         Decimal
  dias_vencimiento     Int
  precio_frigorifico   Decimal
  alta                 Float?
  baja                 Float?
  media                Float?
  precio_tienda        Decimal        @default(0)
  id_admin             Int
  empaques             EMPAQUES[]
  stockNeveras         STOCK_NEVERA[]
  admin                USUARIOS      @relation("AdminProducto", fields: [id_admin], references: [id_usuario])
}

model ESTADO_EMPAQUE {
  id_estado_empaque Int        @id @default(autoincrement())
  nombre_estado     String?
  empaques          EMPAQUES[]
}

model PROMOCIONES {
  id_promocion Int        @id @default(autoincrement())
  nombre       String?
  tipo         String?
  valor        Decimal
  id_admin     Int
  empaques     EMPAQUES[]
  admin        USUARIOS  @relation("AdminPromocion", fields: [id_admin], references: [id_usuario])
}

model EMPAQUES {
  id_empaque             Int             @id @default(autoincrement())
  EPC_id                 String          @unique
  fecha_empaque_1        DateTime
  id_producto            Int
  peso_exacto_g          Decimal
  precio_venta_total     Decimal
  fecha_vencimiento      DateTime        @db.Date
  costo_frigorifico      Decimal
  id_logistica           Int?
  hora_en_logistica_2    DateTime?
  id_nevera              Int?
  hora_en_nevera_3       DateTime?
  hora_pendiente_pago_4  DateTime?
  hora_para_cambio_5     DateTime?
  id_nevera_anterior     Int?
  hora_surtido_final_6   DateTime?
  fecha_finalizacion_7_8 DateTime?
  id_estado_empaque      Int
  promocion_id           Int?
  id_estacion            String
  costo_tienda           Decimal        @default(0)
  id_admin               Int
  estacion               ESTACIONES      @relation(fields: [id_estacion], references: [id_estacion])
  estadoEmpaque          ESTADO_EMPAQUE  @relation(fields: [id_estado_empaque], references: [id_estado_empaque])
  logistica              LOGISTICA?      @relation(fields: [id_logistica], references: [id_logistica])
  nevera                 NEVERAS?        @relation(fields: [id_nevera], references: [id_nevera])
  producto               PRODUCTOS       @relation(fields: [id_producto], references: [id_producto])
  promocion              PROMOCIONES?    @relation(fields: [promocion_id], references: [id_promocion])
  transacciones          TRANSACCIONES[]
  admin                  USUARIOS       @relation("AdminEmpaque", fields: [id_admin], references: [id_usuario])
}

model TEMPERATURA_NEVERA {
  id_temperatura_nevera Int                      @id @default(autoincrement())
  nombre_estado         String?
  reportes              REPORTE_ESTADO_NEVERAS[]
}

model REPORTE_ESTADO_NEVERAS {
  id_reporte_estado     Int                @id @default(autoincrement())
  id_nevera             Int
  hora_reporte          DateTime
  evento                String?
  temperatura_c         Float
  id_temperatura_nevera Int
  id_admin              Int
  nevera                NEVERAS            @relation(fields: [id_nevera], references: [id_nevera])
  estado                TEMPERATURA_NEVERA @relation(fields: [id_temperatura_nevera], references: [id_temperatura_nevera])
  admin                 USUARIOS           @relation("AdminReporteEstado", fields: [id_admin], references: [id_usuario])
}

model TIPO_TRANSACCION {
  id_tipo              Int             @id @default(autoincrement())
  nombre_codigo        String
  descripcion_amigable String?
  transacciones        TRANSACCIONES[]
}

model ESTADO_TRANSACCION {
  id_estado_transaccion Int             @id @default(autoincrement())
  nombre_estado         String
  transacciones         TRANSACCIONES[]
}

model TRANSACCIONES {
  id_transaccion      Int                @id @default(autoincrement())
  id_empaque          Int?
  id_usuario          Int
  id_transaccion_rel  Int?
  id_nevera            Int?
  id_admin            Int
  monto               Decimal
  hora_transaccion    DateTime
  id_tipo_transaccion Int
  nota_opcional       String?
  estado_transaccion  Int
  estadoTransaccion   ESTADO_TRANSACCION @relation(fields: [estado_transaccion], references: [id_estado_transaccion])
  empaque             EMPAQUES?          @relation(fields: [id_empaque], references: [id_empaque])
  tipoTransaccion     TIPO_TRANSACCION   @relation(fields: [id_tipo_transaccion], references: [id_tipo])
  transaccionRel      TRANSACCIONES?     @relation("TransaccionRel", fields: [id_transaccion_rel], references: [id_transaccion])
  transacciones       TRANSACCIONES[]    @relation("TransaccionRel")
  usuario             USUARIOS           @relation("UsuarioTransaccion", fields: [id_usuario], references: [id_usuario])
  nevera              NEVERAS?           @relation(fields: [id_nevera], references: [id_nevera])
  admin               USUARIOS           @relation("AdminTransaccion", fields: [id_admin], references: [id_usuario])
}

model STOCK_NEVERA {
  id                   Int       @id @default(autoincrement())
  id_nevera            Int
  id_producto          Int
  stock_minimo         Int       @default(2)
  stock_maximo         Int       @default(5)
  venta_semanal        Int       @default(0)
  stock_ideal_final    Int
  calificacion_surtido String
  mensaje_sistema      String?
  stock_en_tiempo_real Int
  hora_calificacion    DateTime?
  activo               Boolean   @default(true)
  id_admin             Int
  nevera               NEVERAS   @relation(fields: [id_nevera], references: [id_nevera])
  producto             PRODUCTOS @relation(fields: [id_producto], references: [id_producto])
  admin                USUARIOS  @relation("AdminStockNevera", fields: [id_admin], references: [id_usuario])

  @@unique([id_nevera, id_producto], map: "stock_nevera_unique_id_nevera_id_producto")
}

model BIBLIOTECA {
  id       Int                     @id @default(autoincrement())
  nombre   String
  tipo     TipoMedia
  url      String
  id_admin Int
  items    ITEMS_DE_REPRODUCCION[]
  admin    USUARIOS               @relation("AdminBiblioteca", fields: [id_admin], references: [id_usuario])
}

model LISTA_DE_REPRODUCCION {
  id_lista_reproduccion Int                     @id @default(autoincrement())
  nombre                String
  lista_json            Json?
  id_admin              Int
  items                 ITEMS_DE_REPRODUCCION[]
  neveras               NEVERAS[]
  admin                 USUARIOS               @relation("AdminListaReproduccion", fields: [id_admin], references: [id_usuario])
}

model ITEMS_DE_REPRODUCCION {
  id                    Int                   @id @default(autoincrement())
  id_lista_reproduccion Int
  id_biblioteca         Int
  tiempo_reproduccion_s Int
  orden_reproduccion    Int
  id_admin              Int
  biblioteca            BIBLIOTECA            @relation(fields: [id_biblioteca], references: [id])
  lista_reproduccion    LISTA_DE_REPRODUCCION @relation(fields: [id_lista_reproduccion], references: [id_lista_reproduccion])
  admin                 USUARIOS              @relation("AdminItemsReproduccion", fields: [id_admin], references: [id_usuario])
}

model REFRESH_TOKENS {
  id_refresh_token Int      @id @default(autoincrement())
  id_usuario       Int
  token            String   @unique
  expira_en        DateTime
  fecha_creacion   DateTime @default(now())
  usuario          USUARIOS @relation("UsuarioRefreshToken", fields: [id_usuario], references: [id_usuario])
}

model ESTACIONES {
  id_estacion       String      @id
  id_frigorifico    Int
  clave_vinculacion String      @unique
  activa            Boolean     @default(false)
  fecha_creacion    DateTime    @default(now())
  fecha_activacion  DateTime?
  id_admin          Int
  empaques          EMPAQUES[]
  frigorifico       FRIGORIFICO @relation(fields: [id_frigorifico], references: [id_frigorifico])
  admin             USUARIOS    @relation("AdminEstacion", fields: [id_admin], references: [id_usuario])
}

enum TipoMedia {
  IMAGEN
  VIDEO
}
